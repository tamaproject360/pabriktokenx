# Example environment configuration for CLIProxyAPI.
# Copy this file to `.env` and uncomment the variables you need.
#
# NOTE: Environment variables are only required when using remote storage options.
# For local file-based storage (default), no environment variables need to be set.

# ------------------------------------------------------------------------------
# Management Web UI
# ------------------------------------------------------------------------------
# Used by the backend container and management login page.
# Keep this only in the server-side `.env`, never in `config.docker.yaml`.
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------------------
# Google OAuth Credentials (Security)
# ------------------------------------------------------------------------------
# OAuth credentials for Google-based authentication providers.
# Obtain these from Google Cloud Console: https://console.cloud.google.com/
#
# For Gemini CLI (uses default credentials if not set):
# Default credentials are provided for convenience but can be overridden for security.
# GEMINI_OAUTH_CLIENT_ID=your-gemini-client-id-here.apps.googleusercontent.com
# GEMINI_OAUTH_CLIENT_SECRET=your-gemini-client-secret-here

# For Antigravity (uses default credentials if not set):
# Default credentials are provided with required scopes (cclog, experimentsandconfigs).
# Override these if you need custom OAuth credentials:
# ANTIGRAVITY_OAUTH_CLIENT_ID=your-antigravity-client-id-here.apps.googleusercontent.com
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-antigravity-client-secret-here

# ------------------------------------------------------------------------------
# Postgres Token Store (optional)
# ------------------------------------------------------------------------------
# PGSTORE_DSN=postgresql://user:pass@localhost:5432/cliproxy
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/var/lib/cliproxy

# ------------------------------------------------------------------------------
# Git-Backed Config Store (optional)
# ------------------------------------------------------------------------------
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_USERNAME=git-user
# GITSTORE_GIT_TOKEN=ghp_your_personal_access_token
# GITSTORE_LOCAL_PATH=/data/cliproxy/gitstore

# ------------------------------------------------------------------------------
# Object Store Token Store (optional)
# ------------------------------------------------------------------------------
# OBJECTSTORE_ENDPOINT=https://s3.your-cloud.example.com
# OBJECTSTORE_BUCKET=cli-proxy-config
# OBJECTSTORE_ACCESS_KEY=your_access_key
# OBJECTSTORE_SECRET_KEY=your_secret_key
# OBJECTSTORE_LOCAL_PATH=/data/cliproxy/objectstore
